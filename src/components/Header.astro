---
// Header.astro - WNCPARTSLINGERS Top Utility Bar & Main Navigation
---

<div class="utility-bar">
  <div class="shell">
    <span>Hendersonville, North Carolina</span>
    <span class="utility-center">Warehouse direct · Since 2014</span>
    <div>
      <button type="button">Order status</button>
      <button type="button">Sell your NOS</button>
      <button type="button">Account</button>
    </div>
  </div>
</div>

<header class="main-header">
  <div class="shell header-row">
    <a class="brand" href="/">
      <span class="brand-mark">WNC</span>
      <span>
        <b>PARTSLINGERS</b>
        <small>VINTAGE PARTS SUPPLY CO.</small>
      </span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#categories">Shop parts</a>
      <a href="#new-finds">New finds</a>
      <a href="#oe">OE finder</a>
      <a href="#sell">Sell your NOS</a>
    </nav>
    <div class="header-actions">
      <button type="button" aria-label="Search">SEARCH</button>
      <button type="button" class="cart-button">CART <span>2</span></button>
    </div>
  </div>
</header>
