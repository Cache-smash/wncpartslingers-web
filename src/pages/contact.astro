---
// contact.astro - WNCPARTSLINGERS Customer Support & Inquiries
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | WNCPARTSLINGERS Customer Support</title>
    <meta name="description" content="Customer support, parts fitment inquiries, phone number, and warehouse location for WNCPARTSLINGERS in Hendersonville, NC." />
    <meta name="p:domain_verify" content="84b06eac7f89764d1148798575c74a4a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

    <!-- Header & Navigation -->
    <header class="navbar">
        <a href="/" class="logo">
            <span class="highlight">WNC</span>PARTSLINGERS
        </a>
        <nav>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/#catalog">Catalog</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/shipping">Shipping</a></li>
                <li><a href="/returns">Returns</a></li>
                <li><a href="/contact" class="active">Contact</a></li>
                <li><a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener">eBay Store</a></li>
            </ul>
        </nav>
        <div class="nav-actions">
            <a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener" class="btn-primary">
                <i class="fa-solid fa-store"></i> eBay Storefront
            </a>
        </div>
    </header>

    <main class="pdp-container" style="max-width: 850px; padding: 40px 20px;">
        <span class="tagline">// CUSTOMER SERVICE & SUPPORT</span>
        <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 8px;">Contact Support</h1>
        <p style="color: var(--text-muted); margin-bottom: 32px;">Technical Fitment Assistance & Warehouse Customer Desk · Hendersonville, NC</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; margin-bottom: 32px;">
            <div class="pdp-specs-box">
                <div style="font-size: 1.8rem; color: var(--accent-neon); margin-bottom: 12px;">
                    <i class="fa-solid fa-envelope"></i>
                </div>
                <h3 style="font-size: 1.15rem; margin-bottom: 8px;">Direct Email</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 12px;">Direct correspondence for part requests, interchange questions, and return requests:</p>
                <a href="mailto:parts@wncpartslingers.com" style="color: var(--accent-neon); font-weight: 700; font-size: 1rem; text-decoration: none;">parts@wncpartslingers.com</a>
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 8px;">Response Time: Under 4 hours</p>
            </div>

            <div class="pdp-specs-box">
                <div style="font-size: 1.8rem; color: var(--accent-neon); margin-bottom: 12px;">
                    <i class="fa-solid fa-phone"></i>
                </div>
                <h3 style="font-size: 1.15rem; margin-bottom: 8px;">Customer Phone Desk</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 12px;">Order verification, parts inquiry hotline, and voice assistance:</p>
                <a href="tel:+18286710816" style="color: var(--accent-neon); font-weight: 700; font-size: 1rem; text-decoration: none;">(828) 671-0816</a>
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 8px;">Hours: Mon–Fri, 8:00 AM – 5:00 PM EST</p>
            </div>

            <div class="pdp-specs-box">
                <div style="font-size: 1.8rem; color: var(--accent-neon); margin-bottom: 12px;">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <h3 style="font-size: 1.15rem; margin-bottom: 8px;">Fulfillment Warehouse</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 8px;">Inventory Operations & Returns Center:</p>
                <p style="color: var(--text-main); font-weight: 600;">Hendersonville, North Carolina (28792)</p>
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 8px;">Commercial Carrier Pickups Daily (USPS & UPS)</p>
            </div>
        </div>

        <div class="pdp-specs-box" style="margin-bottom: 24px;">
            <h3 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--text-main);">Order Questions & Messaging</h3>
            <p style="color: var(--text-muted); margin-bottom: 16px;">
                For customers who have purchased through our verified eBay storefront, you can also access 24/7 order messaging directly through your eBay account purchase history for immediate order synchronization and tracking.
            </p>
            <a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener" class="btn-secondary" style="margin-left: 0;">
                <i class="fa-solid fa-message"></i> Contact via eBay Storefront
            </a>
        </div>

        <div class="pdp-specs-box">
            <h3 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--text-main);">Quick Policy Navigation</h3>
            <p style="color: var(--text-muted); margin-bottom: 16px;">Looking for immediate information regarding dispatch or returns?</p>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <a href="/shipping" class="btn-primary" style="padding: 10px 18px; font-size: 0.9rem;">
                    <i class="fa-solid fa-truck"></i> Shipping Policy
                </a>
                <a href="/returns" class="btn-primary" style="padding: 10px 18px; font-size: 0.9rem;">
                    <i class="fa-solid fa-arrow-rotate-left"></i> 30-Day Return Policy
                </a>
                <a href="/terms" class="btn-secondary" style="margin-left: 0; padding: 10px 18px; font-size: 0.9rem;">
                    <i class="fa-solid fa-file-contract"></i> Terms of Service
                </a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 WNCPARTSLINGERS. Built for automotive restorers and performance technicians. · <a href="/about">About Us</a> · <a href="/shipping">Shipping Policy</a> · <a href="/returns">Return Policy</a> · <a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms of Service</a> · <a href="/contact">Contact Us</a> · <a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener">eBay Store</a></p>
    </footer>

</body>
</html>
