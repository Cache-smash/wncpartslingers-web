---
// privacy.astro - WNCPARTSLINGERS Privacy Policy
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Privacy Policy | WNCPARTSLINGERS</title>
    <meta name="description" content="Privacy Policy for WNCPARTSLINGERS." />
    <meta name="p:domain_verify" content="84b06eac7f89764d1148798575c74a4a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

    <!-- Header & Navigation -->
    <header class="navbar">
        <a href="/" class="logo">
            <span class="highlight">WNC</span>PARTSLINGERS
        </a>
        <nav>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/#catalog">Inventory Catalog</a></li>
                <li><a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener">eBay Store</a></li>
                <li><a href="/privacy" class="active">Privacy</a></li>
            </ul>
        </nav>
        <div class="nav-actions">
            <a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener" class="btn-primary">
                <i class="fa-solid fa-store"></i> eBay Storefront
            </a>
        </div>
    </header>

    <main class="pdp-container" style="max-width: 800px; padding: 40px 20px;">
        <span class="tagline">// LEGAL & COMPLIANCE</span>
        <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 8px;">Privacy Policy</h1>
        <p style="color: var(--text-muted); margin-bottom: 32px;">Last updated: October 2026</p>
        
        <div class="pdp-specs-box" style="margin-bottom: 24px;">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: var(--text-main);">1. Information We Collect</h2>
            <p style="color: var(--text-muted);">WNCPARTSLINGERS respects your privacy. When you visit our website, browse our catalog, or communicate with us, we do not sell, rent, or trade your personal information. Transactions and customer data for purchases are handled securely through eBay's checkout and payment platforms.</p>
        </div>

        <div class="pdp-specs-box" style="margin-bottom: 24px;">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: var(--text-main);">2. Use of Information</h2>
            <p style="color: var(--text-muted);">Information provided through direct inquiries is used solely to respond to parts requests, verify vehicle fitment, and coordinate shipments from our warehouse in Hendersonville, NC.</p>
        </div>

        <div class="pdp-specs-box" style="margin-bottom: 24px;">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: var(--text-main);">3. Third-Party Services</h2>
            <p style="color: var(--text-muted);">We utilize trusted third-party platforms including eBay for marketplace transactions and Pinterest/Cloudinary for catalog image distribution.</p>
        </div>

        <div class="pdp-specs-box" style="margin-bottom: 24px;">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: var(--text-main);">4. Contact Us</h2>
            <p style="color: var(--text-muted);">If you have any questions regarding this policy, contact us directly via our eBay store or through your designated order channel.</p>
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 WNCPARTSLINGERS. Built for automotive restorers and performance technicians. · <a href="/privacy">Privacy Policy</a> · <a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener">eBay Store</a></p>
    </footer>

</body>
</html>
