---
// src/pages/index.astro - WNCPARTSLINGERS Automotive Jamstack Storefront
import '../styles/global.css';
import activeItems from '../data/active_ebay_items.json';

// Take the first 48 items for initial server-side render, full list available for client search
const initialItems = activeItems.slice(0, 48);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WNCPARTSLINGERS | NOS & Vintage Automotive Components</title>
    <meta name="description" content="Authentic New Old Stock (NOS) automotive parts, vintage restoration hardware, and factory components. Warehouse direct from Hendersonville, NC." />
    <meta name="p:domain_verify" content="84b06eac7f89764d1148798575c74a4a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

    <!-- Header & Navigation -->
    <header class="navbar">
        <a href="#home" class="logo">
            <span class="highlight">WNC</span>PARTSLINGERS
        </a>
        <nav>
            <ul class="nav-links">
                <li><a href="#home" class="active">Home</a></li>
                <li><a href="#catalog">Inventory Catalog</a></li>
                <li><a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener">eBay Store</a></li>
                <li><a href="/privacy">Privacy</a></li>
            </ul>
        </nav>
        <div class="nav-actions">
            <a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener" class="btn-primary">
                <i class="fa-solid fa-store"></i> eBay Storefront
            </a>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <span class="tagline">// PRECISION VINTAGE & NOS</span>
            <h1>Authentic Automotive <br><span class="highlight">Component Inventory</span></h1>
            <p>High-velocity e-commerce specializing in genuine New Old Stock (NOS) automotive parts, vintage restoration hardware, and rare factory components. Dispatched within 24 hours from Hendersonville, NC.</p>
            <div class="hero-buttons">
                <a href="#catalog" class="btn-primary">
                    <i class="fa-solid fa-boxes-stacked"></i> Browse Catalog ({activeItems.length} Parts)
                </a>
                <a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener" class="btn-secondary">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> eBay Store
                </a>
            </div>
        </div>
    </section>

    <!-- Features / Parts Grid -->
    <section id="catalog" class="parts-section">
        <div class="section-header">
            <h2>Featured Inventory</h2>
            <p>Verified New Old Stock parts, clips, fasteners, and factory replacement assemblies.</p>
        </div>

        <div class="search-container">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input 
                type="text" 
                id="catalog-search" 
                class="search-input" 
                placeholder="Search by part name, MPN, brand, or number..." 
            />
        </div>

        <div class="parts-grid" id="parts-grid">
            {initialItems.map((item) => (
                <div class="part-card" data-title={item.title.toLowerCase()} data-sku={(item.sku || '').toLowerCase()}>
                    <div class="part-image-wrap">
                        <img 
                            src={item.image_url} 
                            alt={item.title} 
                            loading="lazy" 
                            onerror="this.src='https://placehold.co/400x400/181b22/f5f6f8?text=NOS+Part'" 
                        />
                    </div>
                    <h3>{item.title}</h3>
                    <div class="part-price">${typeof item.price === 'number' ? item.price.toFixed(2) : item.price}</div>
                    <div class="card-footer">
                        <span class="spec">{item.sku || 'NOS OEM'}</span>
                        <a href={`/parts/${item.item_id}`} class="download-link">
                            <i class="fa-solid fa-arrow-right"></i> View Details
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 WNCPARTSLINGERS. Built for automotive restorers and performance technicians. · <a href="/privacy">Privacy Policy</a> · <a href="https://www.ebay.com/str/wncpartslingers" target="_blank" rel="noopener">eBay Store</a></p>
    </footer>

    <script is:inline define:vars={{ allItems: activeItems }}>
        const searchInput = document.getElementById('catalog-search');
        const grid = document.getElementById('parts-grid');

        if (searchInput && grid) {
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase().trim();
                if (!query) {
                    // Show initial batch
                    renderItems(allItems.slice(0, 48));
                    return;
                }
                const filtered = allItems.filter(item => 
                    item.title.toLowerCase().includes(query) ||
                    (item.sku && item.sku.toLowerCase().includes(query)) ||
                    item.item_id.includes(query)
                ).slice(0, 60);
                renderItems(filtered);
            });

            function renderItems(items) {
                grid.innerHTML = items.map(item => `
                    <div class="part-card">
                        <div class="part-image-wrap">
                            <img 
                                src="${item.image_url}" 
                                alt="${item.title}" 
                                loading="lazy" 
                                onerror="this.src='https://placehold.co/400x400/181b22/f5f6f8?text=NOS+Part'"
                            />
                        </div>
                        <h3>${item.title}</h3>
                        <div class="part-price">$${typeof item.price === 'number' ? item.price.toFixed(2) : item.price}</div>
                        <div class="card-footer">
                            <span class="spec">${item.sku || 'NOS OEM'}</span>
                            <a href="/parts/${item.item_id}" class="download-link">
                                <i class="fa-solid fa-arrow-right"></i> View Details
                            </a>
                        </div>
                    </div>
                `).join('');
            }
        }
    </script>

</body>
</html>
