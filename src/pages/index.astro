---
// index.astro - WNCPARTSLINGERS High-Velocity Jamstack Storefront
import '../styles/global.css';
import Header from '../components/Header.astro';
import VehicleSelectorHero from '../components/VehicleSelectorHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import WarehouseFinds from '../components/WarehouseFinds.astro';
import MechanicPicks from '../components/MechanicPicks.astro';
import ProductDetailPreview from '../components/ProductDetailPreview.astro';
import SellYourNOS from '../components/SellYourNOS.astro';
import Footer from '../components/Footer.astro';

const garageImage =
  "https://images.unsplash.com/photo-1763848843732-a36a8c9c37da?auto=format&fit=crop&w=1600&q=85";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>WNCPARTSLINGERS | NOS & Vintage Automotive Components</title>
    <meta
      name="description"
      content="Hard-to-find New Old Stock (NOS) automotive parts, vintage factory restoration hardware, and Dorman HELP! fasteners. Warehouse direct from Hendersonville, NC."
    />
    <meta name="p:domain_verify" content="84b06eac7f89764d1148798575c74a4a" />
  </head>
  <body class="app">
    <Header />

    <main>
      <section class="hero">
        <img class="hero-bg" src={garageImage} alt="" fetchpriority="high" />
        <div class="hero-overlay"></div>
        <div class="shell hero-content">
          <div class="hero-copy">
            <p class="eyebrow amber">Warehouse inventory · Western North Carolina</p>
            <h1>THE PART THEY<br />STOPPED MAKING.</h1>
            <p>
              New old stock, restoration hardware, and hard-to-find fasteners—
              cataloged by people who know the difference.
            </p>
          </div>
          <VehicleSelectorHero />
        </div>
      </section>

      <TrustStrip />
      <CategoryGrid />
      <WarehouseFinds />
      <MechanicPicks />
      <ProductDetailPreview />
      <SellYourNOS />
    </main>

    <Footer />
  </body>
</html>
