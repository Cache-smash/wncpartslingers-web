  "description_markdown": "<div align=\"center\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 850px; margin: 0 auto; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); color: #1e293b; line-height: 1.5;\">\n\n  <!-- SECTION 1: BRANDED AUTOMOTIVE HEADER & SUBTITLE BADGE -->\n  <div style=\"background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 24px 20px; border-bottom: 4px solid #0284c7; text-align: center;\">\n    <div style=\"display: inline-block; background-color: #0284c7; color: #ffffff; padding: 4px 14px; border-radius: 9999px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px;\">\n      WNC Parts Slingers \u2022 Precision Direct OE Replacement\n    </div>\n    <h1 style=\"color: #ffffff; font-size: 22px; font-weight: 800; margin: 0 0 10px 0; letter-spacing: -0.01em; line-height: 1.3;\">\n      Dorman 21138 Drum Brake Bar Parking Brake Strut for 1974-94 Ford Mercury LH NOS\n    </h1>\n    <div style=\"color: #94a3b8; font-size: 13px; font-weight: 500;\">\n      Factory Sealed NOS \u2022 OEM Fit &amp; Function \u2022 Verified Specifications\n    </div>\n  </div>\n\n  <div style=\"padding: 24px 22px; text-align: left;\">\n\n    <!-- SECTION 2: KEY SPECIFICATIONS GRID (Modeled after Reference Listing) -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"font-size: 14px; font-weight: 700; color: #0f172a; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 12px 0;\">\n        <span style=\"display: inline-block; width: 4px; height: 16px; background-color: #0284c7; margin-right: 8px; vertical-align: -2px; border-radius: 2px;\"></span>Quick Component Specifications\n      </h3>\n      <table style=\"width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; font-size: 13px;\">\n        <tbody>\n          <tr style=\"background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;\">\n            <td style=\"padding: 10px 14px; font-weight: 700; color: #475569; width: 26%; border-right: 1px solid #e2e8f0;\">Manufacturer &amp; Part #</td>\n            <td style=\"padding: 10px 14px; color: #0f172a; font-weight: 600;\">Dorman 21138</td>\n            <td style=\"padding: 10px 14px; font-weight: 700; color: #475569; width: 24%; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;\">Component Type</td>\n            <td style=\"padding: 10px 14px; color: #0f172a;\">Drum Brake Bar Parking Brake Strut</td>\n          </tr>\n          <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n            <td style=\"padding: 10px 14px; font-weight: 700; color: #475569; border-right: 1px solid #e2e8f0;\">OEM Part Number</td>\n            <td style=\"padding: 10px 14px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: #0369a1; font-weight: 700;\">FORD: D6DZ-2A642-B</td>\n            <td style=\"padding: 10px 14px; font-weight: 700; color: #475569; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;\">Placement on Vehicle</td>\n            <td style=\"padding: 10px 14px; color: #0f172a;\">Rear Left</td>\n          </tr>\n          <tr style=\"background-color: #f8fafc;\">\n            <td style=\"padding: 10px 14px; font-weight: 700; color: #475569; border-right: 1px solid #e2e8f0;\">Placement Details</td>\n            <td style=\"padding: 10px 14px; color: #0f172a;\">Rear Driver Side Drum Brake Assembly (10\" Brakes)</td>\n            <td style=\"padding: 10px 14px; font-weight: 700; color: #475569; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;\">Package Contents</td>\n            <td style=\"padding: 10px 14px; color: #0f172a; font-weight: 600;\">1 Factory Packaged Component</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <!-- SEC